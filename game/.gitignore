# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Scratch output (test runner dumps, one-off tool output)
tmp-*.txt

node_modules
.DS_Store
dist
dist-ssr
coverage
*.local

# Local env files (Supabase anon key etc.) — the repo-root .gitignore
# already covers these; repeated so a bare game/ checkout stays safe.
# .env.example stays tracked as the template.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

*.tsbuildinfo

.eslintcache

# Cypress
/cypress/videos/
/cypress/screenshots/

# Vitest
__screenshots__/

# Lab experiments (personal scratch, see tests/lab/README.md)
/tests/lab/local/

# Vite
*.timestamp-*-*.mjs

# Playwright
/test-results/
/test-results-*.png
/playwright-report/
/blob-report/

# Electron (vite-plugin-electron main/preload build output + electron-builder
# packaging output — named to avoid colliding with the plain web build's
# `dist`, see electron-builder.yml)
dist-electron
release
