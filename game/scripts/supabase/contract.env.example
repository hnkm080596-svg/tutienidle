# Copy to game/.env.supabase.contract and fill in for the staging project.
# .env.* is gitignored - credentials must never reach the repo.
#
# SUPABASE_URL        - project API base, e.g. https://<ref>.supabase.co
# SUPABASE_ANON_KEY   - legacy anon JWT (used as the apikey header)
# SUPABASE_DB_URL     - direct postgres connection string. The direct
#                       db.<ref>.supabase.co:5432 host is IPv6-only on some
#                       networks; the Supavisor pooler works everywhere:
#                       postgresql://postgres.<ref>:<db-password>@<region>.pooler.supabase.com:6543/postgres
# SUPABASE_FRESH_DB_NAME - optional scratch database name for the
#                       fresh-install path (default: contract_fresh)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=
SUPABASE_FRESH_DB_NAME=contract_fresh
