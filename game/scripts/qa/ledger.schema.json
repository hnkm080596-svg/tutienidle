        "authorizedRepairs": {
          "$ref": "#/$defs/texts"
        },
        "nonGoals": {
          "$ref": "#/$defs/texts"
        },
        "checkout": {
          "$ref": "#/$defs/text"
        },
        "branch": {
          "$ref": "#/$defs/text"
        },
        "base": {
          "$ref": "#/$defs/text"
