# Public frontend configuration. Never place the Supabase secret (sb_secret_...) or service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
# Accepts either a Supabase Publishable Key (sb_publishable_...) or legacy anon JWT:
VITE_SUPABASE_ANON_KEY=sb_publishable_your_public_key
# Optional explicit alias (takes precedence over VITE_SUPABASE_ANON_KEY when set):
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# B1.2 — the backend bundle must be declared explicitly: mock | supabase.
# Unset resolves mock in development only; a release build without it
# (or with mock, or with supabase but no credentials) fails closed.
VITE_BACKEND_MODE=mock
