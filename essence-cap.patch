-  const completed = arcs.filter((arc) => arc.boundaryReached)
-  const minArcKills =
-    completed.length === 0
-      ? 0
-      : Math.min(...completed.map((arc) => arc.kills))
-  const residual = bodyChapterRequirement()
-  const requiredRealm = 'mortal'
-  const authoredResidencyKills = Math.ceil(
