{
  "project_dir": "game",
  "worktree_root": ".agent-worktrees",
  "run_root": ".agent-runs",
  "default_mode": "Balanced",
  "max_review_cycles": 2,
  "claude_model": "sonnet",
  "claude_effort": "high",
  "advisor_model": "nvidia/nemotron-mini-4b-instruct",
  "advisor_url": "https://integrate.api.nvidia.com/v1/chat/completions",
  "advisor_timeout_seconds": 300,
  "codex_model": null,
  "verification_commands": [
    ["npm.cmd", "run", "test"],
    ["npm.cmd", "run", "type-check"],
    ["npm.cmd", "run", "build"]
  ]
}
