{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": { "enum": ["PASS", "REQUEST_CHANGES"] },
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "file": { "type": "string" },
          "line": { "type": ["integer", "null"] },
          "problem": { "type": "string" },
          "required_change": { "type": "string" }
        },
        "required": ["severity", "file", "line", "problem", "required_change"]
      }
    }
  },
  "required": ["verdict", "summary", "findings"]
}
